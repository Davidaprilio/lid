# Maintainer: @MAINTAINER@
pkgname=lider
pkgver=@VERSION@
pkgrel=1
pkgdesc="@SUMMARY@"
arch=('x86_64')
url="@URL@"
license=('@LICENSE@')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator')
makedepends=('cargo')
optdepends=('yt-dlp: download YouTube videos'
            'ffmpeg: join YouTube video and audio, convert to MP3'
            'nodejs: unlock YouTube streams (or deno or bun)'
            'deno: unlock YouTube streams')
options=('!lto')
source=("@SOURCE@")
sha256sums=('@SHA256@')
_src=lider-@SRCVERSION@

prepare() {
    cd "$_src"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_src"
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
    # The frontend is already built (ui/dist in the tarball), so no Node.js is needed.
    cargo build --frozen --release -p lider --features tauri/custom-protocol
    cargo build --frozen --release -p lider-sys --bin lider-pack
}

check() {
    cd "$_src"
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
    cargo test --frozen --release -p lider-core --lib
}

package() {
    cd "$_src"
    install -Dm755 target/release/lider "$pkgdir/usr/bin/lider"
    # Browser integration: native messaging host, system-wide host manifests, extension folders.
    target/release/lider-pack system-files "$pkgdir" /usr/lib/lider/lider-native-host /usr/bin/lider
    find "$pkgdir/usr/share/lider" -type d -exec chmod 755 {} + -o -type f -exec chmod 644 {} +
    install -Dm644 lider.desktop "$pkgdir/usr/share/applications/lider.desktop"
    install -Dm644 lider/ui/assets/icons/app.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/lider.svg"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    cp -r third-party "$pkgdir/usr/share/licenses/$pkgname/third-party"
    find "$pkgdir/usr/share/licenses/$pkgname" -type d -exec chmod 755 {} + -o -type f -exec chmod 644 {} +
}
