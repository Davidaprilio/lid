{
  "manifest_version": 3,
  "name": "LID Integration",
  "short_name": "LID",
  "description": "Send downloads, links and videos from the browser to LID (Linux Internet Downloader).",
  "version": "1.1.0",
  "browser_specific_settings": { "gecko": { "id": "lid@davidaprilio.github.io", "strict_min_version": "115.0" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "LID",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "scripts": ["capture.js", "background.js"] },
  "permissions": ["downloads", "contextMenus", "cookies", "nativeMessaging", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["youtube.js"],
      "css": ["youtube.css"],
      "run_at": "document_idle"
    }
  ]
}
